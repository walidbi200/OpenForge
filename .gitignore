# Secrets
.env
opencode.json
opencod-kimie.json

# Runtime artifacts from coder JSON repair failures
failed_coder_raw.json
failed_coder_repaired.json

# Cloned repos and generated repo.json files live here — never commit someone
# else's repository into this one.
workspace/*
!workspace/.gitkeep
workspace_det/

# Run artifacts (repository.json, summary.md, logs.txt) are ephemeral.
runs/

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
validation/*/
