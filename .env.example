# OpenForge Configuration
# GitHub API Token (required for fetching issues and creating PRs)
GITHUB_TOKEN=

# LLM Provider (agentrouter, openrouter, or dahl)
LLM_PROVIDER=agentrouter

# Fallback Provider (optional, used if primary is rate-limited)
LLM_FALLBACK=

# Primary Provider API Key
API_KEY=

# Optional: Specific Provider Keys (overrides API_KEY)
OPENROUTER_API_KEY=
DAHL_API_KEY=
AGENTROUTER_API_KEY=

# Default Model
MODEL=gpt-5.6-sol

# Workspace Directory (where repositories are cloned)
OPENFORGE_WORKSPACE_DIR=workspace
